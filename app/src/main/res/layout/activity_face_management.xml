<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0C1F34">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:background="@drawable/face_manager_top_liner">

        <LinearLayout
            android:id="@+id/face_back_tasks"
            android:layout_width="260dp"
            android:layout_height="match_parent"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:contentDescription="返回任务"
                android:src="@drawable/ic_back_to_task" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="返回任务"
                android:textColor="#FFFFFF"
                android:textSize="32sp"
                android:textStyle="bold" />
        </LinearLayout>
        <View
            android:layout_width="2dp"
            android:layout_height="match_parent"
            android:background="#254A6B" />

        <View
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />

<!--        <Button-->
<!--            android:id="@+id/face_logout"-->
<!--            android:layout_width="260dp"-->
<!--            android:layout_height="match_parent"-->
<!--            android:background="@drawable/bg_face_header_action"-->
<!--            android:gravity="center"-->
<!--            android:padding="0dp"-->
<!--            android:text="退出登录"-->
<!--            android:textAllCaps="false"-->
<!--            android:textColor="#FFAAA7"-->
<!--            android:textSize="32sp"-->
<!--            android:textStyle="bold" />-->
        <LinearLayout
            android:id="@+id/face_logout"
            android:layout_width="260dp"
            android:layout_height="match_parent"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:contentDescription="退出登录"
                android:tint="@color/light_green"
                android:src="@drawable/ic_logout" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="退出登录"
                android:textColor="#EFA29F"
                android:textSize="32sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="30dp"
        android:paddingTop="18dp"
        android:paddingEnd="30dp"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="98dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="2dp"
            android:paddingEnd="2dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:baselineAligned="true"
                android:gravity="bottom"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="已录入人员"
                    android:textColor="#D1DEEA"
                    android:textSize="32sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/face_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:text="0 人"
                    android:textColor="#FFFFFF"
                    android:textSize="46sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <Button
                android:id="@+id/face_add_button"
                android:layout_width="320dp"
                android:layout_height="84dp"
                android:background="@drawable/bg_face_add_button"
                android:gravity="center"
                android:paddingHorizontal="30dp"
                android:text="＋ 录入人脸"
                android:textAllCaps="false"
                android:textColor="#050B18"
                android:textSize="34sp"
                android:layout_marginEnd="10dp"
                android:textStyle="bold" />
        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="14dp"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:overScrollMode="never"
            android:paddingEnd="14dp"
            android:scrollbars="vertical">

            <LinearLayout
                android:id="@+id/face_rows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>
    </LinearLayout>
</LinearLayout>