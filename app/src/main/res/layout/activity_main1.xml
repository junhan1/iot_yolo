<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#101216">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="88dp"
        android:gravity="center_vertical"
        android:paddingStart="48dp"
        android:paddingEnd="48dp"
        android:background="#17191D">

        <TextView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:gravity="center"
            android:text="⌒"
            android:textColor="#15171A"
            android:textSize="30sp"
            android:textStyle="bold"
            android:background="#FFD335" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="安全帽识别"
            android:textColor="#F4F6F8"
            android:textSize="26sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:paddingStart="48dp"
        android:paddingTop="32dp"
        android:paddingEnd="48dp"
        android:paddingBottom="42dp">

        <FrameLayout
            android:id="@+id/video_card"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.66"
            android:background="#080A0C"
            android:clickable="true"
            android:focusable="true">

            <TextureView
                android:id="@+id/camera_preview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="安全帽实时识别画面" />

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#4205080A" />

            <com.example.rknncamera.HmiDetectionOverlay
                android:id="@+id/hmi_overlay"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <LinearLayout
                android:id="@+id/result_badge"
                android:layout_width="wrap_content"
                android:layout_height="80dp"
                android:layout_gravity="bottom|start"
                android:layout_margin="28dp"
                android:gravity="center_vertical"
                android:paddingStart="22dp"
                android:paddingEnd="26dp"
                android:orientation="horizontal"
                android:background="@drawable/bg_hmi_safe_badge">

                <TextView
                    android:id="@+id/result_symbol"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:gravity="center"
                    android:text="✓"
                    android:textColor="#142016"
                    android:textSize="25sp"
                    android:textStyle="bold"
                    android:background="#63C96A" />

                <TextView
                    android:id="@+id/result_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:text="已佩戴安全帽"
                    android:textColor="#EFF9F0"
                    android:textSize="22sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.74"
            android:layout_marginStart="24dp"
            android:orientation="vertical"
            android:background="@drawable/bg_hmi_panel">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:padding="28dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="58dp"
                        android:gravity="center_vertical"
                        android:paddingStart="16dp"
                        android:background="@drawable/bg_hmi_status">

                        <View
                            android:id="@+id/status_indicator"
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:layout_marginEnd="10dp"
                            android:background="@drawable/bg_hmi_status_indicator" />

                        <TextView
                            android:id="@+id/status_line"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:gravity="center_vertical"
                            android:text="状态：RKNN 异步推理中（检测正常）"
                            android:textColor="#E1E9E2"
                            android:textSize="16sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                <GridLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="32dp"
                    android:columnCount="2"
                    android:rowCount="2"
                    android:useDefaultMargins="true">

                    <TextView android:id="@+id/preview_fps" style="@style/HmiMetric" android:text="预览帧率\n0.0 FPS" />
                    <TextView android:id="@+id/inference_fps" style="@style/HmiMetric" android:text="推理帧率\n0.0 FPS" />
                    <TextView android:id="@+id/inference_time" style="@style/HmiMetric" android:text="推理耗时\n等待首帧" />
                    <TextView android:id="@+id/detection_count" style="@style/HmiMetric" android:text="检测数量\n0" />
                </GridLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:background="#15181C">
                    <TextView android:id="@+id/sample_frames" style="@style/HmiDeviceRow" android:text="采样帧数                              0" />
                    <TextView android:id="@+id/input_size" style="@style/HmiDeviceRow" android:text="输入尺寸                              640 × 480" />
                    <TextView android:id="@+id/color_format" style="@style/HmiDeviceRow" android:text="颜色格式                              YUV_420_888" />
                </LinearLayout>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#343940" />

            <LinearLayout
                android:id="@+id/warning_card"
                android:layout_width="match_parent"
                android:layout_height="104dp"
                android:layout_margin="28dp"
                android:gravity="center_vertical"
                android:paddingStart="22dp"
                android:orientation="horizontal"
                android:background="@drawable/bg_hmi_warning">
                <TextView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:gravity="center"
                    android:text="!"
                    android:textColor="#FF746B"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    android:background="#26F44336" />
                <TextView
                    android:id="@+id/warning_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:text="最近连续 2 次未佩戴安全帽"
                    android:textColor="#FF746B"
                    android:textSize="22sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>